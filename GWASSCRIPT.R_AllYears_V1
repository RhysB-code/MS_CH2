  }
  cg <- rbindlist(cand, fill = TRUE)
  cg <- cg[, .(Locus, Gene, Protein_ID = ID, Chrom = Chr, Start, End, Strand, Dist_to_lead_bp, Contains_lead, nSigMarkersInGene,
               LeadSNP, LeadPos, BestScore, Runs_supporting, Araport11 = AT_match, Araport11_desc = AT_desc,
               SwissProt = SP_match, SwissProt_desc = SP_desc, nr_desc = sub("<>.*", "", nr_desc), RefSeq = RS_match)]
  setorder(cg, -BestScore, Locus, Dist_to_lead_bp)

  ## ---- top SNP table per trait x covariate set (across experiments) ----
  top_snp <- pk[, .SD[which.max(Score)], by = .(CovSet, Trait)][order(-Score)]
  top_snp[, GeneContainingSNP := vapply(seq_len(.N), function(k) {
    g <- an[Chr == Chrom[k] & Start <= Position[k] & End >= Position[k]]
    if (!nrow(g)) "intergenic (no gene model spans SNP)" else paste(unique(sub("\\.t[0-9]+$", "", g$ID)), collapse = "; ") }, "")]
  lam <- fread(file.path(sumdir, "Genomic_inflation_and_threshold_by_trait_model.csv"))
  top_snp <- merge(top_snp, lam[, .(CovSet, Trait, Model, Lambda)], by = c("CovSet","Trait","Model"), all.x = TRUE)
  setorder(top_snp, -Score)

  wb <- createWorkbook(); hs <- createStyle(textDecoration = "bold", fgFill = "#305496", fontColour = "white")
