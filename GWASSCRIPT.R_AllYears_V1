        out <- cnt[order(Chrom, Bin), .(Chrom, Bin_start_bp = Bin * BIN, Bin_end_bp = (Bin + 1) * BIN, Count = N)]
        fwrite(out, file.path(den_dir, paste0("Density_", nm, "_bin_counts.csv")))
      }
      dev.off()
      cat("Wrote", fo, "\n")
    }
    writeLines(c("12_Marker_Density_Maps: Density_Markers_and_Genes.png (A = marker density, B = gene density) and *_bin_counts.csv (counts per 1 Mb bin).",
                 "Chromosome lengths come from the annotation file (last gene end) or the last marker, whichever is larger."),
               file.path(den_dir, "README.txt"))
  }
})

# ############################################################
# STAGE 7: FIELD EARLINESS vs LOW-CHILL PERFORMANCE
#   Does a genotype that reaches budbreak earlier in the field also break bud with less chill in the forcing experiments?
#   Field traits come from the audited field-earliness file (pheno_GWASpoly_Earliness_Final.csv: day of year, pooled over years with a genotype + year model;
#   genotype names are already the marker-file names, so they match the low-chill BLUE file directly).
#   A NEGATIVE correlation is expected: earlier field budbreak (smaller day of year) goes with a higher forced-budbreak BLUE.
#   Output: 13_Field_Earliness_vs_LowChill/  (correlation table, binary-trait tests, merged data, scatter figure, calendar-date histograms)
# ############################################################
earliness_file <- file.path(work_dir, "FieldBudbreakGWAS/pheno_GWASpoly_Earliness_Final.csv")
EARL_LABELS <- c(BB10_3yr = "Field 10% budbreak, 2024-2026 (day of year)", BB10_2025_2026 = "Field 10% budbreak, 2025-2026 (day of year)",
                 BB90_2025_2026 = "Field 90% budbreak, 2025-2026 (day of year)", Jan08_0to3 = "January 8 bud score (0-3)", Jan22_0to3 = "January 22 bud score (0-3)")
if (RUN_EARLINESS) local({
  suppressPackageStartupMessages(library(data.table))
  ed <- file.path(root_dir, "13_Field_Earliness_vs_LowChill"); dir.create(ed, recursive = TRUE, showWarnings = FALSE)
  res_file <- file.path(ed, "Field_earliness_vs_lowchill_correlations.csv")
  f_sc <- file.path(ed, "Fig_Field_earliness_vs_lowchill.png"); f_hi <- file.path(ed, "Fig_Field_budbreak_date_histograms.png")
  if (!REDRAW && all(file.exists(res_file, f_sc, f_hi))) { cat("STAGE 7 skipped: results already exist (FORCE_RERUN <- TRUE to redo).\n"); return(invisible()) }
  bl <- file.path(root_dir, "06_GWASpoly_Input/pheno_GWASpoly_LowChill_BLUEs.csv")
  find_file <- function(f) {                                   # if the file is not where expected, look for the same file name anywhere under work_dir
    if (file.exists(f)) return(f)
    hit <- list.files(work_dir, pattern = paste0("^", gsub("([.])", "\\\\\\1", basename(f)), "$"), recursive = TRUE, full.names = TRUE)
    if (length(hit)) { cat("Found", basename(f), "at", hit[1], "\n"); hit[1] } else f
  }
  ef <- find_file(earliness_file)
  if (!file.exists(ef)) { cat("STAGE 7 skipped: cannot find", basename(earliness_file), "under", work_dir, "- set earliness_file (top of Stage 7) to its full path.\n"); return(invisible()) }
  if (!file.exists(bl)) { cat("STAGE 7 skipped: the BLUE file", bl, "does not exist yet (run Stage 1).\n"); return(invisible()) }
  ph <- fread(bl); setnames(ph, 1, "Genotype"); ph[, Genotype := trimws(Genotype)]
  em <- fread(ef, na.strings = c("NA", "")); setnames(em, 1, "Genotype"); em[, Genotype := trimws(Genotype)]
