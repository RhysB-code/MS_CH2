  d[, PF := as.integer(Genotype %in% PF_GENOTYPES)]
  fwrite(d, file.path(ed, "Field_earliness_and_lowchill_by_genotype.csv"))
  one <- function(group, ltr, etr, x, y) {
    ok <- is.finite(x) & is.finite(y); if (sum(ok) < 10) return(NULL)
    sp <- suppressWarnings(cor.test(x[ok], y[ok], method = "spearman", exact = FALSE)); pe <- cor.test(x[ok], y[ok])
    data.table(Group = group, LowChillTrait = trait_label(ltr), FieldTrait = EARL_LABELS[[etr]], n = sum(ok), Spearman = round(unname(sp$estimate), 3), Spearman_P = signif(sp$p.value, 3),
               Pearson = round(unname(pe$estimate), 3), Pearson_P = signif(pe$p.value, 3))
  }
  cont <- intersect(c("BLUE_149", "BLUE_225", "BLUE_257", "BLUE_379", "BLUE_ALL4", "BLUE_EXP3_225_257_379", "BLUE_EXP2_225_257"), names(d))
  out <- list()
  for (ltr in cont) for (etr in tr_e) out[[length(out) + 1]] <- one("All genotypes", ltr, etr, d[[etr]], d[[ltr]])
  for (g in c(0, 1)) if (sum(d$PF == g) >= 10) for (etr in tr_e)
    out[[length(out) + 1]] <- one(if (g == 1) "Primocane-fruiting only" else "Floricane-fruiting only", "BLUE_ALL4", etr, d[[etr]][d$PF == g], d$BLUE_ALL4[d$PF == g])
  res <- rbindlist(out); fwrite(res, res_file); cat("\nField earliness vs low-chill BLUEs (negative = earlier in the field goes with more forced budbreak):\n"); print(res, nrows = 500)
  bin <- data.table()
  for (ltr in intersect(c("BREAK_149", "BREAK_225", "BREAK_257", "BREAK_379", "BREAK_225_257", "BREAK_ANY"), names(d))) for (etr in tr_e) {
