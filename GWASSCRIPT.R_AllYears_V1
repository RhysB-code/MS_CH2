doy_ticks <- function(rng) {      # axis ticks at the 1st and 15th of each month for day-of-year values (non-leap calendar, as in the aligned earliness data)
  dts <- seq(as.Date("2025-01-01"), as.Date("2025-12-31"), by = "1 day"); keep <- format(dts, "%d") %in% c("01", "15")
  at <- as.integer(format(dts[keep], "%j")); lab <- sub(" 0", " ", format(dts[keep], "%b %d")); i <- at >= rng[1] - 1 & at <= rng[2] + 1
  list(at = at[i], lab = lab[i])
}
