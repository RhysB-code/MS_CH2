            diag.panel = function(x, ...) { usr <- par("usr"); on.exit(par(usr = usr)); d <- density(x[is.finite(x)]); par(usr = c(usr[1:2], 0, max(d$y) * 1.1)); lines(d, col = "#0072B2") },
            pch = 16, cex = 0.5, gap = 0.3, col = adjustcolor("#0072B2", 0.6))
      dev.off()
    }
    cat("Wrote", f1, "\n")
  } else cat("Correlation figure skipped (already exists or BLUE file missing).\n")

  # ---------- labelled copy of the BLUE file for sharing (the analysis file keeps its short names) ----------
  f_lab <- file.path(root_dir, "06_GWASpoly_Input", "Budbreak_BLUEs_by_genotype_labeled.csv")
  if (need(f_lab) && file.exists(bl)) {
    lab <- fread(bl); setnames(lab, 1, "Genotype")
    nm <- c(BLUE_149 = "Budbreak BLUE (%), 149 h chill", BLUE_225 = "Budbreak BLUE (%), 225 h chill", BLUE_257 = "Budbreak BLUE (%), 257 h chill", BLUE_379 = "Budbreak BLUE (%), 379 h chill",
            BLUE_ALL4 = "Budbreak BLUE (%), all four experiments combined", BLUE_EXP3_225_257_379 = "Budbreak BLUE (%), 225 + 257 + 379 h combined", BLUE_EXP2_225_257 = "Budbreak BLUE (%), 225 + 257 h combined",
            BREAK_149 = "Broke bud? 149 h chill (1 = yes, 0 = no)", BREAK_225 = "Broke bud? 225 h chill (1 = yes, 0 = no)", BREAK_257 = "Broke bud? 257 h chill (1 = yes, 0 = no)", BREAK_379 = "Broke bud? 379 h chill (1 = yes, 0 = no)",
            BREAK_225_257 = "Broke bud? at 225 h or 257 h (1 = yes, 0 = no)", BREAK_ANY = "Broke bud? in any experiment (1 = yes, 0 = no)", BREAK_PROP = "Proportion of experiments with budbreak (0 to 1)")
    keep <- intersect(names(nm), names(lab)); lab <- lab[, c("Genotype", keep), with = FALSE]
    setnames(lab, keep, unname(nm[keep]))
    for (j in grep("^Budbreak BLUE|^Proportion", names(lab), value = TRUE)) set(lab, j = j, value = round(lab[[j]], 2))
    fwrite(lab, f_lab); cat("Wrote", f_lab, "\n")
  }

  # ---------- BLUE histograms, floricane- vs primocane-fruiting genotypes in two colours ----------
  f2 <- file.path(fig_dir, "Fig2_BLUE_histograms_PF_vs_FF.png")
  if (need(f2) && file.exists(bl)) {
    ph <- fread(bl); setnames(ph, 1, "Genotype")
    ph[, Habit := ifelse(Genotype %in% PF_GENOTYPES, "PF", "FF")]
    hcols <- intersect(c("BLUE_149", "BLUE_225", "BLUE_257", "BLUE_379", "BLUE_ALL4"), names(ph))
    ttl <- function(cl) if (cl == "BLUE_ALL4") "All four experiments" else sprintf("%s h chill", sub("BLUE_", "", cl))
    colFF <- "#0072B2"; colPF <- "#E69F00"                                  # Okabe-Ito blue and orange (colourblind safe)
    png_cairo(f2, 10, 7); par(mfrow = c(2, 3), mar = c(4.5, 4.5, 3, 1))
    for (cl in hcols) {
      v <- ph[[cl]]; ok <- is.finite(v); brk <- pretty(range(v[ok]), 25)
      hf <- hist(v[ok & ph$Habit == "FF"], breaks = brk, plot = FALSE); hp <- hist(v[ok & ph$Habit == "PF"], breaks = brk, plot = FALSE)
      plot(NA, xlim = range(brk), ylim = c(0, max(hf$counts + hp$counts) * 1.08), xlab = paste0(BLUE_NAME, " (% budbreak)"), ylab = "Number of genotypes",
           main = sprintf("%s, n = %d", ttl(cl), sum(ok)), las = 1)
      rect(brk[-length(brk)], 0, brk[-1], hf$counts, col = colFF, border = "white")                       # FF at the bottom
      rect(brk[-length(brk)], hf$counts, brk[-1], hf$counts + hp$counts, col = colPF, border = "white")    # PF stacked on top
      legend("topright", legend = c(sprintf("Floricane-fruiting (n = %d)", sum(ok & ph$Habit == "FF")), sprintf("Primocane-fruiting (n = %d)", sum(ok & ph$Habit == "PF"))),
             fill = c(colFF, colPF), border = NA, bty = "n", cex = 0.85)
    }
    dev.off()
    cat("Wrote", f2, "\n")
  } else cat("PF/FF histogram figure skipped (already exists or BLUE file missing).\n")

  # ---------- marker density maps ----------
  BIN <- 1e6
  CHR <- sprintf("Ra%02d", 1:7)
  read_pos <- function(f) {                                           # first three columns = Marker, Chrom, Position (GWASpoly layout)
    G <- fread(f, select = 1:3, header = TRUE, check.names = FALSE); setnames(G, 1:3, c("Marker", "Chrom", "Position"))
    G[, Position := suppressWarnings(as.numeric(Position))]
    bad <- !(G$Chrom %in% CHR) | is.na(G$Position)
    if (any(bad)) {                                                   # fall back to parsing names such as Ra01:725408_C/G
      m <- regmatches(G$Marker, regexec("^(Ra0[1-7])[:_.-]?([0-9]+)", G$Marker))
      ok <- lengths(m) == 3
      G[ok & bad, `:=`(Chrom = vapply(m[ok & bad], `[`, "", 2), Position = as.numeric(vapply(m[ok & bad], `[`, "", 3)))]
    }
    G[Chrom %in% CHR & is.finite(Position), .(Chrom, Position)]
  }
  maps <- list()
  if (MAKE_FLEX_MAP && file.exists(flex_file))   maps[["FlexSeq_all_markers"]] <- list(pos = read_pos(flex_file), title = "Flex-Seq markers (unfiltered)")   else if (MAKE_FLEX_MAP) cat("Missing:", flex_file, "\n")
  if (file.exists(marker_file)) maps[["Overlap_panel_markers"]] <- list(pos = read_pos(marker_file), title = "Marker density: overlap panel (used in the GWAS)") else cat("Missing:", marker_file, "\n")
  if (file.exists(annot_file) && requireNamespace("readxl", quietly = TRUE)) {
    an <- as.data.table(readxl::read_excel(annot_file, sheet = "Table S8", skip = 2, col_names = FALSE, .name_repair = "minimal")[-1, 1:4])
    setnames(an, c("ID", "Chrom", "Start", "End")); an[, Position := (as.numeric(Start) + as.numeric(End)) / 2]
    maps[["Gene_models"]] <- list(pos = an[Chrom %in% CHR & is.finite(Position), .(Chrom, Position)], title = "Gene density: 'Hillquist' gene models (one count per gene)")
    chr_len <- an[Chrom %in% CHR, .(L = max(as.numeric(End), na.rm = TRUE)), by = Chrom]
  } else chr_len <- NULL
  if (length(maps)) {
    L <- sapply(CHR, function(ch) max(unlist(lapply(maps, function(m) max(m$pos[Chrom == ch, Position], 0))), if (!is.null(chr_len)) chr_len[Chrom == ch, L] else 0))
    xmax <- ceiling(max(L) / 5e6) * 5
    pal  <- c("#F0F0F0", hcl.colors(11, "Viridis"))       # colourblind-safe: grey = no markers, then dark purple (few) to yellow (many)
    fo <- file.path(den_dir, "Density_Markers_and_Genes.png")       # ONE figure: panel A = markers, panel B = genes (stacked, each with its own legend)
    if (!need(fo)) cat("Skipped (exists):", fo, "\n") else {
      np <- length(maps)
      png_cairo(fo, 11, 5.2 * np)
      layout(matrix(1:(2 * np), np, 2, byrow = TRUE), widths = c(10, 1.4))
      for (k in seq_len(np)) {
        nm <- names(maps)[k]; pos <- maps[[nm]]$pos
        pos[, Bin := floor(Position / BIN)]
        cnt <- pos[, .N, by = .(Chrom, Bin)]
        mx <- max(cnt$N); step <- max(1, ceiling(mx / 10))
        labs <- c("0", as.character(c(1, step * (1:9) + 1)), paste0(">", step * 10))
        cls <- function(n) ifelse(n == 0, 1, pmin(12, 2 + floor((n - 1) / step)))
        par(mar = c(1, 5, 5, 0.5))
        plot(NA, xlim = c(0, xmax), ylim = c(7.6, 0.4), xaxt = "n", yaxt = "n", bty = "n", xlab = "", ylab = "", xaxs = "i")
        axis(3, at = seq(0, xmax, 5), labels = paste0(seq(0, xmax, 5), "Mb"), cex.axis = 1.1)
        axis(2, at = 1:7, labels = CHR, las = 1, tick = FALSE, cex.axis = 0.9)
        for (i in 1:7) {
          ch <- CHR[i]; nb <- ceiling(L[i] / BIN)
          n <- rep(0L, nb); cc <- cnt[Chrom == ch]; n[cc$Bin + 1] <- cc$N
          rect(((1:nb) - 1) * BIN / 1e6, i - 0.3, pmin((1:nb) * BIN, L[i]) / 1e6, i + 0.3, col = pal[cls(n)], border = NA)
          rect(0, i - 0.3, L[i] / 1e6, i + 0.3, border = "grey70", col = NA)
        }
        mtext(paste0(LETTERS[k], ". ", sprintf("%s: %s in total, counted per %d Mb bin", maps[[nm]]$title, format(nrow(pos), big.mark = ","), BIN / 1e6)),
              side = 3, line = 3, adj = 0, font = 2, cex = 1)
