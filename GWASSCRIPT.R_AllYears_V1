  r2_with <- function(lead, markers) {
    if (!lead %in% rownames(Mx)) return(rep(NA_real_, length(markers)))
    x <- Mx[lead, ]; m <- intersect(markers, rownames(Mx))
    r <- suppressWarnings(cor(t(Mx[m, , drop = FALSE]), x, use = "pairwise.complete.obs"))^2
    out <- rep(NA_real_, length(markers)); out[match(m, markers)] <- r[, 1]; out
  }
  ld_col <- function(r2) { r2[is.na(r2)] <- 0; cut_i <- cut(r2, c(-1, .2, .4, .6, .8, 1.01), labels = FALSE)
    c("grey65","#4575b4","#66bd63","#fdae61","#d73027")[cut_i] }

  ## ---- locus-zoom plotting ----
  zoom_plot <- function(chrom, lead, lead_pos, cs, trait, model, file) {
    obj <- readRDS(file.path(gwas_dir, cs, "Tables", paste0("scores_", trait, "_", cs, ".rds")))
    sc <- obj$scores; md <- model; if (!md %in% colnames(sc)) return(invisible())
    d <- data.table(obj$map, Score = sc[[md]], thr = unname(obj$thr[md]))
    lo <- lead_pos - HALF_WIN; hi <- lead_pos + HALF_WIN
    w <- d[Chrom == chrom & Position >= lo & Position <= hi & is.finite(Score)]
    if (!nrow(w)) return(invisible())
    w[, r2 := r2_with(lead, Marker)]
    ge <- an[Chr == chrom & End >= lo & Start <= hi]
