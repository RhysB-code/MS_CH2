flex_file <- file.path(work_dir, "FlexSeq_2026_ARK133905_TetraploidPostmean_NOFILTER.csv")
MAKE_FLEX_MAP <- FALSE    # the two thesis figures are the overlap marker density map and the gene density map; set TRUE to also draw the unfiltered Flex-Seq map
if (RUN_FIGS) local({
  suppressPackageStartupMessages(library(data.table))
  need <- function(f) REDRAW || !file.exists(f)
  png_cairo <- function(file, w, h) { if (capabilities("cairo")) png(file, width = w, height = h, units = "in", res = 600, type = "cairo") else png(file, width = w, height = h, units = "in", res = 600) }
  fig_dir <- file.path(root_dir, "05_Figures"); den_dir <- file.path(root_dir, "12_Marker_Density_Maps")
