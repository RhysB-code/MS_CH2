    cat("STAGE 5 skipped: robustness results already exist in 10_Robustness (FORCE_RERUN <- TRUE to redo).\n"); return(invisible())
  }
  suppressPackageStartupMessages(library(data.table))
  {
    # ---------------- USER SETTINGS ----------------
    work_dir   <- "C:/Users/RhysB/OneDrive/Desktop/CH2 GWAS"
    pheno_file <- file.path(work_dir, "LowChillGWAS/Final_Output/06_GWASpoly_Input/pheno_GWASpoly_LowChill_BLUEs.csv")
    geno_file  <- file.path(work_dir, "Overlap_CaptureSeq_FlexSeq_SharedMarkers_GWASready.csv")
    out_dir    <- file.path(work_dir, "LowChillGWAS/Final_Output/10_Robustness")
    LEAD       <- "Ra01:725408_C/G"
    LEAD_MODEL <- "1-dom-ref"
    TRAITS     <- c("BLUE_149", "BLUE_225", "BLUE_257", "BLUE_379")   # single-experiment BLUEs
    THR        <- c("additive" = 4.86, "1-dom-alt" = 4.19, "1-dom-ref" = 4.78)   # M.eff thresholds from your GWASpoly run
    DUP5       <- c("A_2932TN", "APF_477T", "APF_488T", "APF_489T", "APF_499T") # Seq Names present in two lug sets
    thr_f <- file.path(work_dir, "LowChillGWAS/Final_Output/08_GWAS/09_Summary_Tables/Genomic_inflation_and_threshold_by_trait_model.csv")   # thresholds from the rerun above
    if (file.exists(thr_f)) { tt <- fread(thr_f)[CovSet == "K_only" & Trait == "BLUE_149"]; if (nrow(tt) == 3) { THR <- setNames(tt$Threshold, tt$Model); cat("M.eff thresholds taken from the GWAS rerun:", paste(names(THR), round(THR, 2), collapse = ", "), "\n") } }
    PERM_TRAITS <- c("BLUE_149", "BLUE_225")
    N_PERM     <- 1000
    N_RANDOM_SETS <- 5000
    MAF <- 0.05; GENO_FREQ <- 0.95
    set.seed(20261103)
    # ------------------------------------------------

    dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
    sink(file.path(out_dir, "robustness_log.txt"), split = TRUE)
    CHR <- paste0("Ra0", 1:7); MODELS <- c("additive", "1-dom-alt", "1-dom-ref")

    # ---------- read data (same cleaning as the GWAS script) ----------
    ph <- fread(pheno_file); setnames(ph, 1, "Genotype")
    G <- fread(geno_file, header = TRUE, check.names = FALSE); names(G)[1:3] <- c("Marker", "Chrom", "Position")
    G <- G[Chrom %in% CHR]; G <- G[!duplicated(paste(Chrom, Position))]
    ph <- ph[Genotype %in% names(G)]
    panel <- sort(ph$Genotype)
    ph <- ph[match(panel, Genotype)]
    X <- as.matrix(G[, ..panel]); storage.mode(X) <- "numeric"
    X <- pmin(pmax(round(X), 0), 4)
    for (i in which(rowSums(is.na(X)) > 0)) {                      # impute missing with the population mode
      v <- X[i, ]; tb <- table(v); X[i, is.na(v)] <- as.numeric(names(tb)[which.max(tb)])
    }
    chrom <- G$Chrom; pos <- G$Position; mname <- G$Marker
    sdv <- sqrt(pmax(rowMeans(X^2) - rowMeans(X)^2, 0)); poly <- sdv > 0
    n_all <- length(panel)
    PF1 <- PF_GENOTYPES   # primocane-fruiting calls are defined once near the top of the script
    PF <- as.integer(panel %in% PF1)
    cat("Panel:", n_all, "genotypes |", nrow(X), "markers | PF =", sum(PF == 1, na.rm = TRUE), "FF =", sum(PF == 0, na.rm = TRUE),
        "PF unknown =", sum(is.na(PF)), "\n")
    lead_i <- match(LEAD, mname); stopifnot(!is.na(lead_i))

    # ---------- kinship (Endelman A.mat, ploidy 4) and LOCO ----------
    amat <- function(Xm) {
      Z <- Xm * 0.5 - 1; p <- (rowMeans(Z) + 1) / 2
      W <- t(Z - 2 * (p - 0.5)); cc <- 2 * sum(p * (1 - p))
      tcrossprod(W) / cc
    }
    KM <- lapply(CHR, function(ch) amat(X[chrom != ch & poly, , drop = FALSE])); names(KM) <- CHR
    K_ALL <- amat(X[poly, , drop = FALSE])
    rownames(K_ALL) <- colnames(K_ALL) <- panel

    # ---------- marker coding and filters (evaluated on ALL panel genotypes, as GWASpoly does) ----------
    code_m <- function(Xm, m) switch(m, "additive" = Xm, "1-dom-alt" = (Xm >= 1) * 1, "1-dom-ref" = (Xm <= 3) * 1)
    af <- rowMeans(X) / 4
    FILT <- lapply(MODELS, function(m) {
      ok <- pmin(af, 1 - af) >= MAF & poly
      if (m == "additive") mx <- pmax(rowMeans(X == 0), rowMeans(X == 1), rowMeans(X == 2), rowMeans(X == 3), rowMeans(X == 4))
      else { f1 <- rowMeans(code_m(X, m)); mx <- pmax(f1, 1 - f1) }
      ok & mx <= GENO_FREQ
    }); names(FILT) <- MODELS
    cat("Markers passing filters:", paste(MODELS, sapply(FILT, sum), collapse = " | "), "\n")

    # ---------- P3D scan with optional fixed covariates; rotated markers are cached ----------
    reml_delta <- function(yt, lam, Xt) {
      n <- length(yt); p <- ncol(Xt)
      nll <- function(ld) {
        d <- exp(ld); w <- 1 / (lam + d); XtWX <- crossprod(Xt * w, Xt)
        b <- solve(XtWX, crossprod(Xt * w, yt)); r <- yt - Xt %*% b; vg <- sum(w * r^2) / (n - p)
        0.5 * ((n - p) * log(vg) + sum(log(lam + d)) + as.numeric(determinant(XtWX, logarithm = TRUE)$modulus))
      }
      exp(optimize(nll, c(-12, 12), tol = 1e-6)$minimum)
    }
    make_scanner <- function(ok, Z = NULL, models = MODELS) {
      n <- sum(ok); Xf <- cbind(rep(1, n), if (is.null(Z)) NULL else as.matrix(Z)[ok, , drop = FALSE])
      ch <- lapply(CHR, function(cc) {
        sel <- which(chrom == cc)
        e <- eigen(KM[[cc]][ok, ok], symmetric = TRUE); lam <- pmax(e$values, 0); U <- e$vectors
        d <- list(sel = sel, lam = lam, U = U, Xt = crossprod(U, Xf))
        for (m in models) {
          good <- which(FILT[[m]][sel])
          d[[m]] <- list(good = good, Ct = code_m(X[sel[good], ok, drop = FALSE], m) %*% U)
        }
        d
      }); names(ch) <- CHR
      list(ok = ok, n = n, ch = ch, models = models, q = ncol(Xf))
    }
    scan_with <- function(S, y_ok, fixed_delta = NULL) {            # y_ok = phenotype for the genotypes in S$ok
      out <- lapply(S$models, function(m) rep(NA_real_, length(mname))); names(out) <- S$models
      deltas <- numeric(length(CHR)); names(deltas) <- CHR
      for (cc in CHR) {
        d <- S$ch[[cc]]; yt <- as.numeric(crossprod(d$U, y_ok))
        dl <- if (is.null(fixed_delta)) reml_delta(yt, d$lam, d$Xt) else fixed_delta[[cc]]; deltas[cc] <- dl
        sw <- sqrt(1 / (d$lam + dl)); Q <- qr.Q(qr(d$Xt * sw))
        ys <- yt * sw; yp <- ys - Q %*% crossprod(Q, ys); yy <- sum(yp^2); dfe <- S$n - S$q - 1
        for (m in S$models) {
          g <- d[[m]]; if (length(g$good) == 0) next
          Xs <- g$Ct * rep(sw, each = nrow(g$Ct)); Xp <- Xs - (Xs %*% Q) %*% t(Q)
          xx <- rowSums(Xp^2); xy <- as.numeric(Xp %*% yp); b <- xy / xx; rss <- yy - b * xy
          F <- b^2 * xx / (rss / dfe)
          out[[m]][d$sel[g$good]] <- -pf(F, 1, dfe, lower.tail = FALSE, log.p = TRUE) / log(10)
        }
      }
      out
    }
    run_scan <- function(y, Z = NULL, models = MODELS) {            # y = full-panel vector with NA for missing
      ok <- !is.na(y) & (if (is.null(Z)) TRUE else complete.cases(Z))
      S <- make_scanner(ok, Z, models); list(S = S, scores = scan_with(S, y[ok]), ok = ok)
    }
    lead_score <- function(xcode, y, Z = NULL, chr = "Ra01") {       # single marker, arbitrary 0/1 coding
      ok <- !is.na(y) & (if (is.null(Z)) TRUE else complete.cases(Z)); n <- sum(ok)
      Xf <- cbind(rep(1, n), if (is.null(Z)) NULL else as.matrix(Z)[ok, , drop = FALSE])
      e <- eigen(KM[[chr]][ok, ok], symmetric = TRUE); lam <- pmax(e$values, 0); U <- e$vectors
      yt <- as.numeric(crossprod(U, y[ok])); Xt <- crossprod(U, Xf); dl <- reml_delta(yt, lam, Xt)
      sw <- sqrt(1 / (lam + dl)); Q <- qr.Q(qr(Xt * sw)); yp <- yt * sw; yp <- yp - Q %*% crossprod(Q, yp)
      xp <- as.numeric(crossprod(U, xcode[ok])) * sw; xp <- xp - Q %*% crossprod(Q, xp)
      xx <- sum(xp^2); xy <- sum(xp * yp); b <- xy / xx; q <- ncol(Xf); F <- b^2 * xx / ((sum(yp^2) - b * xy) / (n - q - 1))
      -pf(F, 1, n - q - 1, lower.tail = FALSE, log.p = TRUE) / log(10)
    }
    top_of <- function(sc) rbindlist(lapply(names(sc), function(m) { i <- which.max(sc[[m]]); data.table(Model = m, TopScore = round(sc[[m]][i], 2), TopMarker = mname[i], nAboveMEff = sum(sc[[m]] >= THR[m], na.rm = TRUE)) }))
    lambda_gc <- function(s) { s <- s[is.finite(s)]; median(qchisq(10^(-s), 1, lower.tail = FALSE)) / qchisq(0.5, 1) }
    res_rows <- list()
    add_res <- function(Trait, Analysis, sc, n) {
      t <- top_of(sc); t[, `:=`(Trait = Trait, Analysis = Analysis, n = n, LeadScore = round(sc[["1-dom-ref"]][lead_i], 2))]
      res_rows[[length(res_rows) + 1]] <<- t
    }

    # ============================================================
    # A. REPRODUCE THE GWAS (validation against your GWASpoly output)
    # ============================================================
    cat("\n================ A. VALIDATION ================\n")
    blue <- function(tr) ph[[tr]]
    base <- list()
    for (tr in TRAITS) {
      r <- run_scan(blue(tr)); base[[tr]] <- r; add_res(tr, "baseline", r$scores, sum(r$ok))
      cat(tr, "| n =", sum(r$ok), "| lead (", LEAD_MODEL, ") =", round(r$scores[[LEAD_MODEL]][lead_i], 2),
          "| lambda(additive) =", round(lambda_gc(r$scores$additive), 2), "\n")
    }
    cat("Compare these top markers and the lead score with the GWASpoly table 'Top_markers_per_trait_model.csv'.\n",
        "Scores should agree to within about 0.5 (GWASpoly uses its own REML routine).\n")

    # ============================================================
    # B. WHO IS IN THE LEAD CLASS?
    # ============================================================
    cat("\n================ B. LEAD-MARKER CLASS ================\n")
    x <- X[lead_i, ]
    cat("Dosage counts over the panel:\n"); print(table(Dosage = x))
    cat("\nDosage x fruiting habit (PF = 1):\n"); print(table(Dosage = x, PF = PF, useNA = "ifany"))
    tab2 <- table(Class4 = x == 4, PF = PF == 1); print(fisher.test(tab2))
    members <- data.table(Seq = panel, Dosage = x, PF = PF)[Dosage == 4]
    for (tr in TRAITS) set(members, j = tr, value = round(ph[[tr]][match(members$Seq, panel)], 1))
    fwrite(members, file.path(out_dir, "Lead_class_members.csv")); print(members, nrows = 100)

    mean_off <- function(idx) { S <- K_ALL[idx, idx, drop = FALSE]; n <- length(idx); (sum(S) - sum(diag(S))) / (n * (n - 1)) }
    cat("\nRelatedness among class members vs random same-size sets of PF genotypes (per experiment):\n")
    rel_rows <- list()
    for (tr in TRAITS) {
      inexp <- which(!is.na(ph[[tr]])); mem <- intersect(which(x == 4), inexp); pool <- intersect(which(PF == 1), inexp)
      if (length(mem) < 3) next
      obs <- mean_off(mem); rnd <- replicate(N_RANDOM_SETS, mean_off(sample(pool, length(mem))))
      rel_rows[[tr]] <- data.table(Trait = tr, nClass = length(mem), MeanRelationship = round(obs, 3),
                                   RandomPF_Mean = round(mean(rnd), 3), P_random_ge_obs = mean(rnd >= obs))
    }
    rel <- rbindlist(rel_rows); print(rel); fwrite(rel, file.path(out_dir, "Class_relatedness_vs_random_PF_sets.csv"))

    # ============================================================
    # C. SENSITIVITY SCANS
    # ============================================================
    cat("\n================ C. SENSITIVITY SCANS ================\n")
    for (tr in TRAITS) {
      y <- blue(tr)
      yd <- y; yd[panel %in% DUP5] <- NA
      r <- run_scan(yd);                 add_res(tr, "drop 5 duplicated genotypes", r$scores, sum(r$ok))
      r <- run_scan(y, Z = PF);          add_res(tr, "PF as fixed covariate", r$scores, sum(r$ok))
      yf <- y; yf[is.na(PF) | PF != 1] <- NA
      r <- run_scan(yf);                 add_res(tr, "PF lines only", r$scores, sum(r$ok))
    }
    res <- rbindlist(res_rows)[, .(Trait, Analysis, n, Model, TopScore, TopMarker, nAboveMEff, LeadScore)]
    fwrite(res, file.path(out_dir, "Sensitivity_scans_summary.csv"))
    print(res[order(Trait, Analysis, Model)], nrows = 500)

    # ============================================================
    # D + E. LEAVE-ONE-OUT AND MANN-WHITNEY
    # ============================================================
    cat("\n================ D/E. LEAVE-ONE-OUT AND MANN-WHITNEY ================\n")
    xc <- as.numeric(x <= 3)       # 1-dom-ref coding: 1 = dosage 0-3, 0 = dosage 4
    loo_rows <- list()
    for (tr in c("BLUE_149", "BLUE_225", "BLUE_257")) {
      y <- blue(tr); ok <- !is.na(y); mem <- which(ok & x == 4); if (length(mem) < 3) next
      base_s <- lead_score(xc, y)
      cat(sprintf("\n%s: class n = %d, baseline lead score %.2f\n", tr, length(mem), base_s))
      wt <- suppressWarnings(wilcox.test(y[ok & x == 4], y[ok & x < 4]))
      cat(sprintf("  Mann-Whitney class vs all others: p = %.2g (medians %.1f vs %.1f)\n", wt$p.value, median(y[ok & x == 4]), median(y[ok & x < 4])))
      okp <- ok & !is.na(PF) & PF == 1
      if (sum(okp & x == 4) >= 3) {
        wp <- suppressWarnings(wilcox.test(y[okp & x == 4], y[okp & x < 4]))
        cat(sprintf("  Mann-Whitney within PF lines only: p = %.2g (class n = %d vs %d)\n", wp$p.value, sum(okp & x == 4), sum(okp & x < 4)))
      }
      for (i in mem) { y2 <- y; y2[i] <- NA
        loo_rows[[length(loo_rows) + 1]] <- data.table(Trait = tr, Dropped = panel[i], BLUE = round(y[i], 1), LeadScore = round(lead_score(xc, y2), 2)) }
      ord <- mem[order(-y[mem])]
      for (k in 1:3) { y2 <- y; y2[ord[1:k]] <- NA
        loo_rows[[length(loo_rows) + 1]] <- data.table(Trait = tr, Dropped = paste("top", k, "highest-BLUE members:", paste(panel[ord[1:k]], collapse = "+")),
                                                       BLUE = NA_real_, LeadScore = round(lead_score(xc, y2), 2)) }
    }
    loo <- rbindlist(loo_rows); print(loo, nrows = 200); fwrite(loo, file.path(out_dir, "Leave_one_out_lead_score.csv"))

    # ============================================================
    # F. WHITENED-RESIDUAL PERMUTATION (empirical genome-wide threshold)
    # ============================================================
    cat("\n================ F. PERMUTATION THRESHOLDS (", N_PERM, "permutations ) ================\n", sep = "")
    perm_rows <- list()
    if (!RUN_PERM) cat("Skipped: RUN_PERM is FALSE (optional; set TRUE near the top of the script to run).\n")
    for (tr in if (RUN_PERM) PERM_TRAITS else character(0)) for (adj in c("none", "PF")) {
      y <- blue(tr); Z <- if (adj == "PF") PF else NULL
      ok <- !is.na(y) & (if (is.null(Z)) TRUE else !is.na(Z))
      S <- make_scanner(ok, Z); obs <- scan_with(S, y[ok])
      e <- eigen(K_ALL[ok, ok], symmetric = TRUE); lam <- pmax(e$values, 0); U <- e$vectors
      Xf <- cbind(rep(1, sum(ok)), if (is.null(Z)) NULL else Z[ok]); Xt <- crossprod(U, Xf); yt <- as.numeric(crossprod(U, y[ok]))
      dl <- reml_delta(yt, lam, Xt); w <- 1 / (lam + dl)
      b <- solve(crossprod(Xt * w, Xt), crossprod(Xt * w, yt)); fit <- as.numeric(Xt %*% b); r <- sqrt(w) * (yt - fit)
      mx <- matrix(NA_real_, N_PERM, length(MODELS), dimnames = list(NULL, MODELS))
      t0 <- Sys.time()
      for (k in seq_len(N_PERM)) {
        ys <- as.numeric(U %*% (fit + sample(r) / sqrt(w)))
        sc <- scan_with(S, ys); mx[k, ] <- sapply(MODELS, function(m) max(sc[[m]], na.rm = TRUE))
      }
      allmax <- apply(mx, 1, max)
      cat(sprintf("\n%s | covariate: %s | n = %d | %.0f s\n", tr, adj, S$n, as.numeric(difftime(Sys.time(), t0, units = "secs"))))
      for (m in MODELS) {
        o <- max(obs[[m]], na.rm = TRUE)
        perm_rows[[length(perm_rows) + 1]] <- data.table(Trait = tr, Covariate = adj, Model = m, ObservedTop = round(o, 2),
          EmpThreshold95 = round(quantile(mx[, m], 0.95), 2), MEffThreshold = THR[m], EmpP_top = (1 + sum(mx[, m] >= o)) / (N_PERM + 1))
      }
      lead_o <- obs[[LEAD_MODEL]][lead_i]
      perm_rows[[length(perm_rows) + 1]] <- data.table(Trait = tr, Covariate = adj, Model = "ANY model (family-wise)", ObservedTop = round(lead_o, 2),
          EmpThreshold95 = round(quantile(allmax, 0.95), 2), MEffThreshold = NA_real_, EmpP_top = (1 + sum(allmax >= lead_o)) / (N_PERM + 1))
      fwrite(rbindlist(perm_rows), file.path(out_dir, "Permutation_thresholds.csv"))      # saved after every trait/covariate so an interruption loses nothing
    }
    if (length(perm_rows)) { perm <- rbindlist(perm_rows); print(perm) }
    cat("\nNote: the permutation null uses whole-genome kinship for whitening while the scan uses LOCO kinship, and the BLUEs are skewed,\n",
        "so null lambda is above 1; the empirical thresholds are conservative. Report them as a sensitivity analysis, not a replacement for M.eff.\n")
    cat("\nDone. Files are in:", out_dir, "\n")
    sink()
  }
})

