        Mean_field_broke = round(mean(x1), 2), Mean_field_not = round(mean(x0), 2), Wilcoxon_P = signif(wilcox.test(x1, x0)$p.value, 3)))
  }
  fwrite(bin, file.path(ed, "Field_earliness_vs_binary_budbreak.csv")); cat("\nField earliness by did / did not break bud:\n"); print(bin, nrows = 200)

  # ---- figure 1: scatter (field date vs forced budbreak); calendar dates on the field axis ----
  pe <- if ("BB10_3yr" %in% tr_e) "BB10_3yr" else tr_e[1]
  is_date <- pe %in% c("BB10_3yr", "BB10_2025_2026", "BB90_2025_2026")
  png_cairo(f_sc, 6, 5); par(mar = c(4.8, 4.8, 3, 1))
  cc <- ifelse(d$PF == 1, COL_PF, COL_FF); xr <- range(d[[pe]], na.rm = TRUE); tk <- doy_ticks(xr)
  plot(d[[pe]], d$BLUE_ALL4, pch = 16, col = adjustcolor(cc, 0.6), cex = 0.8, xaxt = "n", ylab = paste0(BLUE_NAME, ", all four experiments (% budbreak)"),
       xlab = if (is_date) "Field budbreak date (estimate over the recorded years)" else EARL_LABELS[[pe]], main = "Field earliness vs forced budbreak", las = 1)
  if (is_date) axis(1, at = tk$at, labels = tk$lab, cex.axis = 0.8) else axis(1)
  ok <- is.finite(d[[pe]]) & is.finite(d$BLUE_ALL4); if (sum(ok) > 5) abline(lm(d$BLUE_ALL4[ok] ~ d[[pe]][ok]), lwd = 1.5)
  r1 <- res[Group == "All genotypes" & FieldTrait == EARL_LABELS[[pe]] & LowChillTrait == trait_label("BLUE_ALL4")]
  legend("topright", bty = "n", cex = 0.9, legend = c(if (nrow(r1)) sprintf("Spearman = %.2f (n = %d)", r1$Spearman[1], r1$n[1]), "Primocane-fruiting", "Floricane-fruiting"),
         pch = c(if (nrow(r1)) NA, 16, 16), col = c(if (nrow(r1)) NA, COL_PF, COL_FF))
  dev.off()

  # ---- figure 2: histograms with the calendar date on the x axis (top row = low-chill panel, bottom row = every genotype in the field file; PF stacked on FF) ----
  date_hist <- function(v, hab, ttl) {
    ok <- is.finite(v); v <- v[ok]; hab <- hab[ok]
    brk <- seq(floor(min(v) / 3) * 3, ceiling(max(v) / 3) * 3 + 3, by = 3)               # 3-day bins
    hf <- hist(v[hab == "FF"], breaks = brk, plot = FALSE); hp <- hist(v[hab == "PF"], breaks = brk, plot = FALSE)
    plot(NA, xlim = range(brk), ylim = c(0, max(hf$counts + hp$counts) * 1.12), xaxt = "n", xlab = "", ylab = "Number of genotypes", main = sprintf("%s (n = %d)", ttl, length(v)), las = 1, cex.main = 0.95)
    rect(brk[-length(brk)], 0, brk[-1], hf$counts, col = COL_FF, border = "white")
    rect(brk[-length(brk)], hf$counts, brk[-1], hf$counts + hp$counts, col = COL_PF, border = "white")
    tk2 <- doy_ticks(range(brk)); axis(1, at = tk2$at, labels = tk2$lab, las = 2, cex.axis = 0.8)
    legend("topright", legend = c(sprintf("Floricane-fruiting (n = %d)", sum(hab == "FF")), sprintf("Primocane-fruiting (n = %d)", sum(hab == "PF"))), fill = c(COL_FF, COL_PF), border = NA, bty = "n", cex = 0.8)
  }
  hp_tr <- intersect(c("BB10_3yr", "BB10_2025_2026", "BB90_2025_2026"), tr_e)
  if (length(hp_tr)) {
    png_cairo(f_hi, 4.7 * length(hp_tr), 9); par(mfrow = c(2, length(hp_tr)), mar = c(5.6, 4.5, 3.2, 1))
