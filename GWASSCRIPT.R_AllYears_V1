if (RUN_BLUES) {
  blue_csv <- file.path(root_dir, "06_GWASpoly_Input/pheno_GWASpoly_LowChill_BLUEs.csv")
  stage1_done <- file.exists(blue_csv) && all(ALL_TRAITS %in% names(fread(blue_csv, nrows = 0)))
  if (stage1_done && !FORCE_RERUN) {
    cat("STAGE 1 skipped: the BLUE file already exists with all", length(ALL_TRAITS), "traits. (FORCE_RERUN <- TRUE to redo.)\n")
  } else {
  if (!requireNamespace("emmeans", quietly = TRUE)) stop("Please run install.packages('emmeans') once.")
  EXP_HOURS <- c("1.1" = 149, "1.2" = 225, "2.1" = 257, "2.2" = 379)   # chill hours per experiment
  MIN_BUDS  <- 10        # a plot with fewer total buds than this is treated as missing
                         # (0-bud rows are not real zeros). Set to 1 to drop only 0-bud rows.
  DROP_SEQ  <- "Not Included in SNP Panel"      # Seq Name value for plants with no genotype
  ALIASES   <- c(Osage = "A_2362T", Ouachita = "A_1905T")   # cultivar name -> selection code
  CHECK_ADJUST <- TRUE   # TRUE = remove lug-set effects estimated from the Osage/Ouachita checks before fitting BLUEs

  # OPTIONAL: chill-model table for the chill figure. Leave as NA to skip.
  # CSV with one row per experiment and columns: Exp, and one column per chill model,
  # e.g.  Exp,ChillHours,Utah,ChillPortions   (Exp = 1.1, 1.2, 2.1, 2.2)
  CHILL_FILE <- NA_character_
  BREAK_THRESH <- 0      # binary trait: a genotype "broke" in an experiment if its mean % budbreak across blocks is above this
  THRESH_PCT <- 20       # "chill needed to reach this % budbreak" (used only with CHILL_FILE)

  # ---- output folders (everything is written under out_dir) ----
  dirs <- list(log   = file.path(out_dir, "00_Log"),
               clean = file.path(out_dir, "01_Cleaned_Data"),
               exp   = file.path(out_dir, "02_Per_Experiment_BLUEs"),
               diag  = file.path(out_dir, "03_Residual_Diagnostics"),
               comb  = file.path(out_dir, "04_Combined_Models"),
               fig   = file.path(out_dir, "05_Figures"),
               gwas  = file.path(out_dir, "06_GWASpoly_Input"),
               chk   = file.path(out_dir, "07_Data_Checks"))
  for (dd in dirs) dir.create(dd, recursive = TRUE, showWarnings = FALSE)
  # high-quality PNG: 600 dpi, size in inches
  save_png <- function(file, w, h) {
    if (capabilities("cairo")) png(file, width = w, height = h, units = "in", res = 600, type = "cairo")
    else png(file, width = w, height = h, units = "in", res = 600)
  }
  sink(file.path(dirs$log, "budbreak_analysis_log.txt"), split = TRUE)

  norm_id <- function(x) toupper(gsub("[-_ ]", "", trimws(as.character(x))))
  skew <- function(x) { x <- x[is.finite(x)]; m <- mean(x); s <- sd(x); if (s == 0) NA_real_ else mean((x - m)^3) / s^3 }
  kurt <- function(x) { x <- x[is.finite(x)]; m <- mean(x); s <- sd(x); if (s == 0) NA_real_ else mean((x - m)^4) / s^4 - 3 }

  # ============================================================
  # 1. READ AND CLEAN
  # ============================================================
  cat("================ 1. READ AND CLEAN ================\n")
  d <- fread(pheno_file, header = TRUE, encoding = "UTF-8", fill = TRUE,
             colClasses = list(character = c("Genotype", "Seq Name", "Treatment", "Lug_ID", "Lug Position")))
  names(d)[1] <- sub("^\ufeff", "", names(d)[1])   # remove a byte-order mark if present
  setnames(d, c("Genotype", "Seq Name", "Treatment", "Lug_ID", "Lug Position", "Order", "Total Buds", "Buds_Broken_Percent"),
              c("Genotype", "Seq", "Exp", "LugID", "LugPos", "Order", "TotalBuds", "PctFrac"), skip_absent = TRUE)
  cat("Rows read:", nrow(d), "\n")

  d[, Exp := trimws(Exp)]
  d[, Seq := trimws(Seq)]
  d[, Genotype := trimws(Genotype)]
  d[, TotalBuds := as.numeric(TotalBuds)]
  d[, PctFrac := as.numeric(PctFrac)]

  # Block (A-D). Normally the last letter of Lug_ID (e.g. L6A). A few rows have a stray comma in
  # the genotype label that pushes the lug code into the next column, so look there too.
  get_block <- function(lug, pos) {
    b <- ifelse(grepl("^L[0-9]+[A-D]$", lug), sub("^L[0-9]+([A-D])$", "\\1", lug), NA_character_)
    b2 <- ifelse(grepl("^L[0-9]+[A-D]$", pos), sub("^L[0-9]+([A-D])$", "\\1", pos), NA_character_)
    ifelse(is.na(b), b2, b)
  }
  d[, Block := get_block(LugID, LugPos)]
  n_shift <- d[!grepl("^L[0-9]+[A-D]$", LugID) & !is.na(Block), .N]
  if (n_shift > 0) cat("Rows with the lug code shifted into the next column (block recovered):", n_shift, "\n")
  if (d[is.na(Block), .N] > 0) { cat("WARNING: rows with no recoverable block (dropped):", d[is.na(Block), .N], "\n"); d <- d[!is.na(Block)] }

  unknown_exp <- setdiff(unique(d$Exp), names(EXP_HOURS))
  if (length(unknown_exp) > 0) stop("Unexpected experiment codes in Treatment: ", paste(unknown_exp, collapse = ", "))

  # plots that cannot be genotype-matched
  n_nosnp <- d[Seq == DROP_SEQ, .N]
  cat("Rows with Seq Name '", DROP_SEQ, "' (dropped): ", n_nosnp, "\n", sep = "")
  d <- d[Seq != DROP_SEQ & Seq != "" & !is.na(Seq)]

  # remove spaces inside names, then apply cultivar aliases (Osage = A_2362T, Ouachita = A_1905T)
  d[, Seq := gsub("\\s+", "", Seq)]
  d[Seq %in% names(ALIASES), Seq := ALIASES[Seq]]

  # the same Seq Name carrying more than one Genotype label (e.g. a rename or a VLOOKUP slip)
  cl <- d[, .(Labels = paste(sort(unique(Genotype)), collapse = " | "), nLabels = uniqueN(Genotype)), by = Seq][nLabels > 1]
  if (nrow(cl) > 0) {
    cat("\nSeq Names that carry more than one Genotype label (check these against your name tables):\n")
    print(cl[, .(Seq, Labels)], nrows = 1000)
    fwrite(cl, file.path(dirs$chk, "SeqName_with_multiple_Genotype_labels.csv"))
  }

  # 0-bud and very-low-bud plots are missing data, not zeros
  n_lowbud <- d[TotalBuds < MIN_BUDS | is.na(TotalBuds), .N]
  cat("\nPlots with fewer than", MIN_BUDS, "buds set to missing:", n_lowbud, "\n")
  d[, Pct := ifelse(TotalBuds >= MIN_BUDS, 100 * PctFrac, NA_real_)]
  if (d[Pct < 0 | Pct > 100, .N] > 0) cat("WARNING: values outside 0-100 found.\n")
  d <- d[!is.na(Pct)]
  d[, ExpHours := EXP_HOURS[Exp]]
  # ---- CHECK ADJUSTMENT: Osage + Ouachita are in every lug, so they identify lug-SET differences ----
  # Each lug set is a fixed group of ~24 genotypes, so set is confounded with genotype and can only be
  # estimated from the checks. Model on checks: Pct ~ check + block + set. The centred set effects are
  # subtracted from the non-check plots; block is still handled by the genotype + block model below.
  d[, LugFix := ifelse(grepl("^L[0-9]+[A-D]$", LugID), LugID, LugPos)]
  d[, SetNo := sub("^L([0-9]+)[A-D]$", "\\1", LugFix)]
  d[, PctRaw := Pct]
  d[, SetEff := 0]
  if (CHECK_ADJUST) {
    chk_out <- list()
    for (e in names(EXP_HOURS)) {
      ck <- d[Exp == e & Seq %in% ALIASES & !is.na(SetNo)]
      if (uniqueN(ck$SetNo) < 2 || nrow(ck) < 10) { cat("Exp", e, ": too few check plots, no adjustment\n"); next }
      ck[, `:=`(CheckF = factor(Seq), BlockF = factor(Block), SetF = factor(SetNo))]
      fit1 <- lm(Pct ~ CheckF + BlockF + SetF, data = ck)
      fit0 <- lm(Pct ~ CheckF + BlockF, data = ck)
      pF <- anova(fit0, fit1)$`Pr(>F)`[2]
      es <- as.data.table(as.data.frame(emmeans::emmeans(fit1, ~ SetF)))
      es[, `:=`(SetNo = as.character(SetF), SetEffC = emmean - mean(emmean))]
      d[Exp == e & !(Seq %in% ALIASES), SetEff := es$SetEffC[match(SetNo, es$SetNo)]]
      chk_out[[e]] <- es[, .(Exp = e, SetNo, SetEffect = SetEffC, SE)][, `:=`(F_test_p = pF, nCheckPlots = nrow(ck))]
      cat(sprintf("Exp %s: %d check plots, set effect F-test p = %.3g, SD of set effects = %.1f\n",
                  e, nrow(ck), pF, sd(es$SetEffC)))
    }
    if (length(chk_out) > 0) fwrite(rbindlist(chk_out), file.path(dirs$chk, "Check_derived_lug_set_effects.csv"))
    d[is.na(SetEff), SetEff := 0]
    d[!(Seq %in% ALIASES), Pct := PctRaw - SetEff]     # no truncation at 0 or 100: BLUEs are left untransformed
  }
  fwrite(d[, .(Genotype, Seq, Exp, ExpHours, Block, LugID, SetNo, TotalBuds, PctRaw, SetEff, Pct)],
         file.path(dirs$clean, "Budbreak_cleaned_plot_level.csv"))

  # Replicated plants (the Osage/Ouachita checks appear 10x per block) are averaged within a
  # genotype x block cell so a check does not carry more weight than a single-plant selection.
  cells <- d[, .(Pct = mean(Pct), PctRaw = mean(PctRaw), nPlants = .N), by = .(Exp, ExpHours, Seq, Block)]   # Pct = check-adjusted (BLUEs); PctRaw = unadjusted (binary traits, zero counts)
  cells[, `:=`(Exp = factor(Exp, levels = names(EXP_HOURS)), SeqF = factor(Seq), BlockF = factor(Block))]
  cat("Genotype x block cells:", nrow(cells), "| distinct genotypes:", uniqueN(cells$Seq), "\n")
  cat("\nCells and genotypes per experiment:\n")
  print(cells[, .(Cells = .N, Genotypes = uniqueN(Seq),
                  MedianBlocksPerGenotype = median(as.numeric(table(Seq)))), by = Exp][order(Exp)])
  cat("\nGenotypes seen in only ONE block of an experiment (single-plot estimates, treat with caution):\n")
  single <- cells[, .(nBlocks = .N), by = .(Exp, Seq)][nBlocks == 1]
  print(single[, .N, by = Exp][order(Exp)])
  fwrite(single, file.path(dirs$chk, "Genotypes_with_single_block.csv"))
  cat("\nDistribution of cell-level % budbreak by experiment:\n")
  print(cells[, .(Mean = round(mean(Pct), 2), Median = round(median(Pct), 2), Max = round(max(Pct), 1),
                  PctCellsAtZero_raw = round(100 * mean(PctRaw == 0), 1), Skew = round(skew(Pct), 2)), by = Exp][order(Exp)])

  # ============================================================
  # 2. PER-EXPERIMENT RCBD: genotype + block fixed  -> BLUEs
  # ============================================================
  cat("\n================ 2. PER-EXPERIMENT RCBD (genotype + block fixed) ================\n")
  blue_list <- list(); diag_rows <- list()
  for (e in names(EXP_HOURS)) {
    ce <- cells[Exp == e]
    if (nrow(ce) == 0) next
    ce[, `:=`(SeqF = factor(Seq), BlockF = factor(Block))]
    fit <- lm(Pct ~ SeqF + BlockF, data = ce)
    em  <- as.data.table(as.data.frame(emmeans::emmeans(fit, ~ SeqF)))
    em  <- em[is.finite(emmean), .(Seq = as.character(SeqF), BLUE = emmean, SE = SE)]
    nb  <- ce[, .(nBlocks = .N), by = Seq]
    em  <- merge(em, nb, by = "Seq")
    em[, `:=`(Exp = e, ExpHours = EXP_HOURS[e])]
    blue_list[[e]] <- em

    r <- residuals(fit); f <- fitted(fit)
    sw <- if (length(r) >= 3 && length(r) <= 5000) shapiro.test(r)$p.value else NA_real_
    diag_rows[[e]] <- data.table(Exp = e, Hours = EXP_HOURS[e], nGenotypes = nrow(em), ResidDF = df.residual(fit),
      BLUE_mean = mean(em$BLUE), BLUE_SD = sd(em$BLUE), BLUE_min = min(em$BLUE), BLUE_max = max(em$BLUE),
      BLUE_skew = skew(em$BLUE), BLUE_kurt = kurt(em$BLUE), PctBLUEbelow0 = 100 * mean(em$BLUE < 0),
      Resid_skew = skew(r), Resid_Shapiro_p = sw,
      SpearmanAbsResid_vs_Fitted = suppressWarnings(cor(abs(r), f, method = "spearman")),
      ReliabilityApprox = max(0, (var(em$BLUE) - mean(em$SE^2)) / var(em$BLUE)))

    save_png(file.path(dirs$diag, sprintf("Diagnostics_Exp%s_%sh.png", e, EXP_HOURS[e])), 7, 7)
    par(mfrow = c(2, 2), mar = c(4.5, 4.5, 3, 1))
    plot(f, r, pch = 16, col = rgb(0, 0, 0, 0.35), xlab = "Fitted % budbreak", ylab = "Residual",
         main = sprintf("Residuals vs fitted (%d h)", EXP_HOURS[e])); abline(h = 0, lty = 2, col = "red")
    qqnorm(r, pch = 16, col = rgb(0, 0, 0, 0.35), main = "Residual normal QQ"); qqline(r, col = "red")
    hist(r, breaks = 30, col = "grey80", border = "white", main = "Residuals", xlab = "Residual")
    hist(em$BLUE, breaks = 30, col = "#3B6FB6", border = "white", main = sprintf("%s, %d h chill", BLUE_NAME, EXP_HOURS[e]), xlab = paste0(BLUE_NAME, " (% budbreak)"))
    dev.off()
  }
  blues_by_exp <- rbindlist(blue_list)
  fwrite(blues_by_exp[, .(Genotype = Seq, Exp, ExpHours, BLUE, SE, nBlocks)][order(Exp, Genotype)],
         file.path(dirs$exp, "BLUEs_per_experiment_long.csv"))
  diag_tab <- rbindlist(diag_rows)
  cat("\nBLUE distribution and residual diagnostics by experiment:\n")
  print(diag_tab[, lapply(.SD, function(x) if (is.numeric(x)) round(x, 3) else x)], nrows = 100)
  cat("\nHow to read this: strong BLUE/residual skew and Shapiro p near 0 are expected at 149 h (most cells at 0).\n",
      "A positive Spearman for |resid| vs fitted means variance grows with the mean. No transformation or binning is\n",
      "applied here; if you want to try one, add it after this step and compare against these BLUEs.\n", sep = "")
  fwrite(diag_tab, file.path(dirs$diag, "BLUE_distribution_and_residual_diagnostics.csv"))

  # ============================================================
  # 3. COMBINED MODELS (all fixed): genotype + experiment, block nested in experiment
  # ============================================================
  cat("\n================ 3. COMBINED MODELS ================\n")
  combined_blues <- function(exps, label) {
    ce <- copy(cells[as.character(Exp) %in% exps])
    ce[, `:=`(SeqF = factor(Seq), ExpF = factor(as.character(Exp)), ExpBlock = factor(paste(Exp, Block, sep = "_")))]
    # ExpBlock = block nested within experiment; it also absorbs the experiment main effect
    fit_add <- lm(Pct ~ ExpBlock + SeqF, data = ce)
    fit_gxe <- lm(Pct ~ ExpBlock + SeqF + SeqF:ExpF, data = ce)
    cat(sprintf("\n--- %s: experiments %s ---\n", label, paste(exps, collapse = ", ")))
    cat("Cells:", nrow(ce), "| genotypes:", nlevels(ce$SeqF), "| residual df (additive):", df.residual(fit_add), "\n")
    cat("Sequential ANOVA, additive model (experiment-block, then genotype):\n"); print(anova(fit_add))
    cat("Genotype x experiment test (additive vs interaction model):\n"); print(anova(fit_add, fit_gxe))
    em <- as.data.table(as.data.frame(emmeans::emmeans(fit_add, ~ SeqF)))
    em <- em[is.finite(emmean), .(Seq = as.character(SeqF), BLUE = emmean, SE = SE)]
    nexp <- ce[, .(nExp = uniqueN(Exp), nCells = .N), by = Seq]
    em <- merge(em, nexp, by = "Seq"); em[, Model := label]
    capture.output(anova(fit_add), anova(fit_add, fit_gxe), file = file.path(dirs$comb, paste0("ANOVA_", label, ".txt")))
    fwrite(em[, .(Genotype = Seq, Model, BLUE, SE, nExp, nCells)][order(Genotype)], file.path(dirs$comb, paste0("BLUEs_", label, ".csv")))
    cat("BLUE mean / SD / skew:", round(mean(em$BLUE), 2), "/", round(sd(em$BLUE), 2), "/", round(skew(em$BLUE), 2), "\n")
    cat("Genotypes in fewer than", length(exps), "experiments (adjusted for experiment, but less precise):",
        em[nExp < length(exps), .N], "\n")
    em
  }
  b_all4 <- combined_blues(names(EXP_HOURS), "ALL4_149_225_257_379")
  b_3exp <- combined_blues(c("1.2", "2.1", "2.2"), "EXP3_225_257_379")
  b_2exp <- combined_blues(c("1.2", "2.1"), "EXP2_225_257")      # 225 h + 257 h (close in chill units)

  # ============================================================
  # 4. GENOTYPE x EXPERIMENT: does genetic spread change with chill?
  # ============================================================
  cat("\n================ 4. GENOTYPE x EXPERIMENT ================\n")
  wide <- dcast(blues_by_exp, Seq ~ ExpHours, value.var = "BLUE")
  setnames(wide, as.character(EXP_HOURS), paste0("BLUE_", EXP_HOURS), skip_absent = TRUE)
  rank_cols <- intersect(paste0("BLUE_", EXP_HOURS), names(wide))
  cat("Spearman rank correlations of BLUEs between experiments (pairwise complete):\n")
  rk <- cor(wide[, ..rank_cols], use = "pairwise.complete.obs", method = "spearman"); print(round(rk, 2))
  cat("\nPearson correlations:\n"); pr <- cor(wide[, ..rank_cols], use = "pairwise.complete.obs"); print(round(pr, 2))
  cat("\nGenotype spread by experiment (BLUE SD, and SD after removing estimation error):\n")
  print(blues_by_exp[, .(nGenotypes = .N, BLUE_SD = round(sd(BLUE), 2),
                         GenotypicSD_approx = round(sqrt(max(0, var(BLUE) - mean(SE^2))), 2),
                         MeanSE = round(mean(SE), 2)), by = .(Hours = ExpHours)][order(Hours)])
  cat("\nIf GenotypicSD_approx rises with chill hours the genotypes are separating as they receive more chilling.\n",
      "High rank correlations with a significant genotype x experiment F test would match the 'scale, not rank' expectation.\n", sep = "")
  write.csv(round(rk, 3), file.path(dirs$comb, "BLUE_rank_correlations_between_experiments.csv"))

  # ============================================================
  # 5. BUILD THE ONE-ROW-PER-GENOTYPE TABLE AND MATCH TO THE MARKER FILE
  # ============================================================
  cat("\n================ 5. GWASpoly INPUT (one row per genotype) ================\n")
  pheno <- merge(wide, b_all4[, .(Seq, BLUE_ALL4 = BLUE)], by = "Seq", all = TRUE)
  pheno <- merge(pheno, b_3exp[, .(Seq, BLUE_EXP3_225_257_379 = BLUE)], by = "Seq", all = TRUE)
  pheno <- merge(pheno, b_2exp[, .(Seq, BLUE_EXP2_225_257 = BLUE)], by = "Seq", all = TRUE)
  # ---- binary did / did not break traits (one per treatment, plus combined across treatments) ----
  brk <- cells[, .(Break = as.integer(mean(PctRaw) > BREAK_THRESH)), by = .(Exp, Seq)]   # binary traits use the RAW (unadjusted) percentages
  brk_w <- dcast(brk, Seq ~ Exp, value.var = "Break")
  setnames(brk_w, names(EXP_HOURS), paste0("BREAK_", EXP_HOURS), skip_absent = TRUE)
  brk_cols <- intersect(paste0("BREAK_", EXP_HOURS), names(brk_w))
  brk_w[, nTested := rowSums(!is.na(.SD)), .SDcols = brk_cols]
  brk_w[, BREAK_ANY  := as.integer(rowSums(.SD, na.rm = TRUE) > 0), .SDcols = brk_cols]                 # broke in at least one treatment
  if (all(c("BREAK_225", "BREAK_257") %in% names(brk_w)))      # broke in the 225 h and/or the 257 h experiment
    brk_w[, BREAK_225_257 := ifelse(is.na(BREAK_225) & is.na(BREAK_257), NA_integer_, as.integer(pmax(BREAK_225, BREAK_257, na.rm = TRUE)))]
  brk_w[, BREAK_PROP := ifelse(nTested >= 2, rowSums(.SD, na.rm = TRUE) / nTested, NA_real_), .SDcols = brk_cols]  # share of tested treatments in which it broke
  cat("\nBinary budbreak traits (1 = mean % budbreak above ", BREAK_THRESH, "): prevalence among genotypes tested\n", sep = "")
  print(round(sapply(intersect(c(brk_cols, "BREAK_225_257", "BREAK_ANY"), names(brk_w)), function(cn) mean(brk_w[[cn]], na.rm = TRUE)), 2))
  cat("Genotypes with BREAK_PROP (tested in at least 2 treatments):", sum(is.finite(brk_w$BREAK_PROP)), "\n")
  fwrite(brk_w, file.path(dirs$comb, "Binary_budbreak_by_treatment.csv"))
  pheno <- merge(pheno, brk_w[, intersect(c("Seq", brk_cols, "BREAK_225_257", "BREAK_ANY", "BREAK_PROP"), names(brk_w)), with = FALSE], by = "Seq", all.x = TRUE)
  nb_wide <- dcast(blues_by_exp, Seq ~ ExpHours, value.var = "nBlocks"); setnames(nb_wide, as.character(EXP_HOURS), paste0("nBlocks_", EXP_HOURS), skip_absent = TRUE)
  pheno <- merge(pheno, nb_wide, by = "Seq", all.x = TRUE)
  setnames(pheno, "Seq", "Genotype")
  cat("Genotypes with a BLUE:", nrow(pheno), "\n")

  mk_hdr <- names(fread(marker_file, nrows = 0))
  if (!identical(tolower(mk_hdr[1:3]), c("marker", "chrom", "position")))
    cat("WARNING: first three marker-file columns are not Marker/Chrom/Position:", paste(mk_hdr[1:3], collapse = ", "), "\n")
  samp <- mk_hdr[-(1:3)]
  cat("Marker file sample columns:", length(samp), "| duplicated column names:", sum(duplicated(samp)), "\n")
  key <- norm_id(samp)
  pick <- function(nm) {
    ex <- which(samp == nm)
    if (length(ex) > 0) return(c(samp[ex[1]], "exact"))
    cand <- which(key == norm_id(nm))
    if (length(cand) == 0) return(c(NA, "NONE"))
    pref <- cand[!grepl("_FLEX$", samp[cand])]            # prefer the Capture-Seq column over a _FLEX copy
    c(samp[if (length(pref) > 0) pref[1] else cand[1]], "normalized")
  }
  m <- t(vapply(pheno$Genotype, pick, character(2)))
  pheno[, `:=`(MarkerColumn = m[, 1], MatchType = m[, 2])]
  cat("Name match to marker file:\n"); print(table(pheno$MatchType))
  nomatch <- pheno[MatchType == "NONE", Genotype]
  if (length(nomatch) > 0) { cat("\nNOT FOUND in the marker file (cannot be used in GWAS):\n"); print(nomatch) }
  dupcol <- pheno[!is.na(MarkerColumn)][duplicated(MarkerColumn) | duplicated(MarkerColumn, fromLast = TRUE)]
  if (nrow(dupcol) > 0) { cat("\nWARNING: several phenotype names point to the same marker column (merge or fix):\n"); print(dupcol[, .(Genotype, MarkerColumn)]) }

  fwrite(pheno, file.path(dirs$gwas, "Budbreak_BLUEs_all_genotypes_with_match_flags.csv"))
  gw <- pheno[!is.na(MarkerColumn) & !(MarkerColumn %in% dupcol$MarkerColumn)]
  gw_out <- gw[, c("MarkerColumn", intersect(c(paste0("BLUE_", EXP_HOURS), "BLUE_ALL4", "BLUE_EXP3_225_257_379", "BLUE_EXP2_225_257", paste0("BREAK_", EXP_HOURS), "BREAK_225_257", "BREAK_ANY", "BREAK_PROP"), names(gw))), with = FALSE]
  setnames(gw_out, "MarkerColumn", "Genotype")
  setorder(gw_out, Genotype)
  stopifnot(!anyDuplicated(gw_out$Genotype), all(gw_out$Genotype %in% samp), !any(grepl("\\s", gw_out$Genotype)))
  fwrite(gw_out, file.path(dirs$gwas, "pheno_GWASpoly_LowChill_BLUEs.csv"), na = "NA")
  cat("\nWrote pheno_GWASpoly_LowChill_BLUEs.csv: ", nrow(gw_out), " genotypes (one row each, names = marker column names).\n", sep = "")
  cat("Trait columns:", paste(setdiff(names(gw_out), "Genotype"), collapse = ", "), "\n")
  cat("Genotypes with BLUEs but no genotype data are listed above and in Budbreak_BLUEs_all_genotypes_with_match_flags.csv.\n")

  cat("\nBLUE comparison, all four experiments vs three experiments (225/257/379):\n")
  cmp <- gw_out[is.finite(BLUE_ALL4) & is.finite(BLUE_EXP3_225_257_379)]
  cat("Pearson r:", round(cor(cmp$BLUE_ALL4, cmp$BLUE_EXP3_225_257_379), 3),
      "| Spearman rho:", round(cor(cmp$BLUE_ALL4, cmp$BLUE_EXP3_225_257_379, method = "spearman"), 3),
      "| n =", nrow(cmp), "\n")

  # ============================================================
  # 6. FIGURE: histograms (diagonal), r (upper), scatter (lower)
  # ============================================================
  cat("\n================ 6. FIGURES ================\n")
  panel_hist <- function(x, ...) {
    usr <- par("usr"); on.exit(par(usr = usr))
    x <- x[is.finite(x)]; h <- hist(x, plot = FALSE, breaks = 20)
    par(usr = c(usr[1:2], 0, max(h$counts) * 1.15))
    rect(h$breaks[-length(h$breaks)], 0, h$breaks[-1], h$counts, col = "#E69F00", border = "white")
  }
  panel_cor <- function(x, y, ...) {
    usr <- par("usr"); on.exit(par(usr = usr)); par(usr = c(0, 1, 0, 1))
    ok <- is.finite(x) & is.finite(y); r <- cor(x[ok], y[ok])
    text(0.5, 0.5, sprintf("%.2f", r), cex = 1.4 + 1.2 * abs(r), col = if (abs(r) > 0.7) "#B03A2E" else "grey25")
  }
  panel_pts <- function(x, y, ...) { points(x, y, pch = 16, cex = 0.5, col = rgb(0, 0, 0, 0.35)); abline(lm(y ~ x), col = "#B03A2E", lwd = 1.2) }

  # Fig1 (correlation figure, same style as Godwin et al. 2025) is drawn in Stage 6 so it is made even when stage 1 is skipped.

  # Fig2 (BLUE histograms, primocane- vs floricane-fruiting genotypes in two colours) is drawn in Stage 6 so it is made even when stage 1 is skipped.

  # Optional chill-model figure: chill needed to reach THRESH_PCT % budbreak under each chill model
  if (!is.na(CHILL_FILE) && file.exists(CHILL_FILE)) {
    ch <- fread(CHILL_FILE); ch[, Exp := as.character(Exp)]
    mods <- setdiff(names(ch), "Exp")
    req_one <- function(y, x) {                       # y = BLUE at the 4 experiments in chill order, x = chill metric
      ok <- is.finite(y); y <- cummax(y[ok]); x <- x[ok]
      i <- which(y >= THRESH_PCT)[1]
      if (is.na(i)) return(NA_real_)
      if (i == 1) return(x[1])
      x[i - 1] + (THRESH_PCT - y[i - 1]) / (y[i] - y[i - 1]) * (x[i] - x[i - 1])
    }
    bw <- dcast(blues_by_exp, Seq ~ Exp, value.var = "BLUE")
    ex <- names(EXP_HOURS)
    reqs <- lapply(mods, function(mo) {
      x <- ch[match(ex, Exp), get(mo)]
      sapply(seq_len(nrow(bw)), function(i) req_one(as.numeric(unlist(bw[i, ..ex])), x))
    })
    names(reqs) <- paste0("Req_", mods)
    rq <- data.table(Genotype = bw$Seq, as.data.table(reqs))
    fwrite(rq, file.path(dirs$comb, sprintf("Chill_needed_for_%s_pct_budbreak_by_chill_model.csv", THRESH_PCT)))
    fd <- as.data.frame(rq[, -1])
    fd <- fd[rowSums(is.finite(as.matrix(fd))) >= 2, , drop = FALSE]
    if (nrow(fd) > 10) {
      save_png(file.path(dirs$fig, "Fig3_Chill_model_requirement_correlation.png"), 8, 8)
      pairs(fd, diag.panel = panel_hist, upper.panel = panel_cor, lower.panel = panel_pts, gap = 0.4,
            main = sprintf("Chill needed to reach %d%% budbreak, by chill model", THRESH_PCT))
      dev.off()
    }
    cat("Chill-model figure written (genotypes that never reach the threshold are NA).\n")
  } else cat("No CHILL_FILE set: skipped the chill-model figure.\n")

  writeLines(c("Final_Output folder map",
    "00_Log                  analysis log (all printed results, ANOVA tables, counts)",
    "01_Cleaned_Data         cleaned plot-level data",
    "02_Per_Experiment_BLUEs genotype BLUEs +/- SE from each experiment's RCBD",
    "03_Residual_Diagnostics residual/QQ/BLUE histograms per experiment + diagnostics table",
    "04_Combined_Models      combined-model BLUEs, ANOVA tables, rank correlations",
    "05_Figures              600-dpi PNGs: correlation matrix, BLUE histograms, chill-model figure",
    "06_GWASpoly_Input       pheno_GWASpoly_LowChill_BLUEs.csv (one row per genotype) + match flags",
    "07_Data_Checks          names, single-block genotypes and other items to review"),
    file.path(out_dir, "README_folder_map.txt"))
  cat("\nDone. Files are in:", out_dir, "(see README_folder_map.txt)\n")
  cat("Send back 00_Log/budbreak_analysis_log.txt (or paste the console) so I can check the numbers.\n")
  sink()   # if the script stops early, run sink() once in the console to close the log file

  }  # end of "else" (stage 1 not skipped)
}

# ############################################################
# STAGE 2: GWASpoly (kinship only)
# ############################################################
if (RUN_GWAS) {
  suppressPackageStartupMessages(library(GWASpoly))
  blue_pheno_file <- file.path(root_dir, "06_GWASpoly_Input/pheno_GWASpoly_LowChill_BLUEs.csv")
  out_dir <- file.path(root_dir, "08_GWAS")
  TRAITS      <- ALL_TRAITS
  MODELS      <- c("additive", "1-dom")
  COVARIATE_SETS <- list(K_only = 0L)   # number of marker PCs used as fixed covariates
  REAL_CHROMS <- paste0("Ra0", 1:7)                 # chromosomes analysed (unplaced scaffolds dropped)
  MIN_MAF     <- 0.05     # GWASpoly set.params(MAF = ...)   (package default is 0.01)
  MAX_GENO_FREQ <- 0.95   # GWASpoly set.params(geno.freq = ...) (package default is 0.99)
  THRESH_LEVEL  <- 0.05   # M.eff Bonferroni family-wise level
  PEAK_WINDOW   <- 1e6    # significant markers on one chromosome within this many bp are grouped into one peak
  FIGURE_W <- 13; FIGURE_H <- 4.8   # inches; Manhattan on the left, its QQ plot on the right, 600 dpi (same as the field-earliness GWAS)
  TOP_N         <- 25     # top markers per trait x model written out even if nothing crosses the threshold
  N_CORES       <- max(1L, parallel::detectCores() - 1L)
  # ------------------------------------------------

  dir_in  <- file.path(out_dir, "00_Input")
  dir.create(dir_in, recursive = TRUE, showWarnings = FALSE)
  sink(file.path(out_dir, "gwas_log.txt"), split = TRUE)
  save_png <- function(file, w, h) {
    if (capabilities("cairo")) png(file, width = w, height = h, units = "in", res = 600, type = "cairo")
    else png(file, width = w, height = h, units = "in", res = 600)
  }

  # ============================================================
  # 1. READ + ALIGN GENOTYPES AND PHENOTYPES
  # ============================================================
  cat("================ 1. INPUT ================\n")
  ph <- fread(blue_pheno_file)
  setnames(ph, 1, "Genotype")
  traits_present <- intersect(TRAITS, names(ph))
  if (length(traits_present) < length(TRAITS)) cat("Traits not found in phenotype file (skipped):", setdiff(TRAITS, traits_present), "\n")
  TRAITS <- traits_present
  stopifnot(!anyDuplicated(ph$Genotype), length(TRAITS) > 0)
  for (tr in grep("^BREAK_", TRAITS, value = TRUE)) cat(sprintf("  %-11s n = %d | proportion that broke = %.2f\n", tr, sum(is.finite(ph[[tr]])), mean(ph[[tr]], na.rm = TRUE)))
  cat("Phenotype rows (one per genotype):", nrow(ph), "| traits:", paste(TRAITS, collapse = ", "), "\n")

  G <- fread(marker_file, header = TRUE, check.names = FALSE)
  names(G)[1:3] <- c("Marker", "Chrom", "Position")
  cat("Genotype file:", nrow(G), "markers x", ncol(G) - 3, "samples\n")
  G <- G[Chrom %in% REAL_CHROMS]
  cat("Markers on", paste(REAL_CHROMS[c(1, length(REAL_CHROMS))], collapse = "-"), ":", nrow(G), "\n")
  G <- G[!duplicated(paste(Chrom, Position))]

  missing_geno <- setdiff(ph$Genotype, names(G))
  if (length(missing_geno) > 0) {
    cat("Phenotyped genotypes with NO marker column (dropped from GWAS):", paste(missing_geno, collapse = ", "), "\n")
    ph <- ph[Genotype %in% names(G)]
  }
  samples <- ph$Genotype
  M <- as.matrix(G[, ..samples]); storage.mode(M) <- "numeric"
  cat("Samples used:", length(samples), "\n")
  cat("Dosage range:", paste(range(M, na.rm = TRUE), collapse = " to "),
      "| % non-integer cells before rounding:", round(100 * mean(abs(M - round(M)) > 0.05, na.rm = TRUE), 2), "\n")
  M <- pmin(pmax(round(M), 0), 4)                    # integer dosage 0-4, as in the earlier GWAS runs
  cat("% missing genotype cells:", round(100 * mean(is.na(M)), 2), "\n")

  # ---- write GWASpoly input files (shared by every run) ----
  geno_out <- file.path(dir_in, "geno_GWASpoly_input.csv")
  fwrite(cbind(G[, .(Marker, Chrom, Position)], as.data.table(M)), geno_out)
  cat("Wrote", geno_out, "\n")

  # ============================================================
  # helpers: QQ, lambda, Manhattan, tables
  # ============================================================
  lambda_gc <- function(s) { s <- s[is.finite(s)]; chisq <- qchisq(10^(-s), 1, lower.tail = FALSE); median(chisq) / qchisq(0.5, 1) }
  qq_panel <- function(s, main = "") {
    s <- sort(s[is.finite(s)], decreasing = TRUE); n <- length(s)
    e <- -log10((seq_len(n) - 0.5) / n)
    lo <- -log10(qbeta(0.975, seq_len(n), n - seq_len(n) + 1)); hi <- -log10(qbeta(0.025, seq_len(n), n - seq_len(n) + 1))
    plot(e, s, type = "n", xlab = expression(Expected ~ -log[10](p)), ylab = expression(Observed ~ -log[10](p)), main = main,
         xlim = c(0, max(e)), ylim = c(0, max(s, e)), las = 1)
    polygon(c(e, rev(e)), c(lo, rev(hi)), col = "grey88", border = NA)
    abline(0, 1, col = "red", lty = 2); points(e, s, pch = 16, cex = 0.5, col = rgb(0, 0, 0, 0.5))
    legend("topleft", bty = "n", cex = 0.95, legend = sprintf("lambda = %.2f", lambda_gc(s)))
  }
  manhattan_panel <- function(map, s, thr, main = "") {
    chr <- factor(map$Chrom, levels = REAL_CHROMS)
    chrlen <- tapply(map$Position, chr, max, na.rm = TRUE); chrlen[is.na(chrlen)] <- 0
    offset <- c(0, cumsum(as.numeric(chrlen)))[seq_along(chrlen)]; names(offset) <- names(chrlen)
    x <- map$Position + offset[as.character(chr)]
    col <- ifelse(as.integer(chr) %% 2 == 1, "#2C5F8A", "#8AA9C6")
    ymax <- max(c(s, thr), na.rm = TRUE) * 1.08
    plot(x, s, pch = 16, cex = 0.5, col = col, xaxt = "n", xlab = "", ylab = expression(-log[10](p)), main = main,
         ylim = c(0, ymax), xlim = c(0, sum(as.numeric(chrlen))), bty = "l", las = 1)
    axis(1, at = offset + chrlen / 2, labels = names(chrlen), tick = FALSE, cex.axis = 0.95)
    abline(h = thr, col = "#D55E00", lty = 2)
    sig <- which(is.finite(s) & s > thr); if (length(sig) > 0) points(x[sig], s[sig], pch = 16, cex = 0.8, col = "#D55E00")
  }
  draw_pair <- function(file, map, s, thr, tr, md, n) {          # ONE Manhattan plot with ITS OWN QQ plot beside it (same layout as the field-earliness GWAS)
    save_png(file, FIGURE_W, FIGURE_H)
    layout(matrix(1:2, nrow = 1), widths = c(3, 1.1)); par(oma = c(0, 0, 2.6, 0))
    par(mar = c(3.4, 4.8, 1, 1)); manhattan_panel(map, s, thr)
    par(mar = c(4.4, 4.6, 1, 1)); qq_panel(s)
    mtext(sprintf("%s  |  %s  |  kinship only", trait_label(tr), model_label(md)), outer = TRUE, line = 1.2, cex = 1.05, font = 2)
    mtext(sprintf("n = %d genotypes  |  M.eff threshold = %.2f  |  lambda = %.2f", n, thr, lambda_gc(s)), outer = TRUE, line = 0, cex = 0.85, col = "grey30")
    dev.off()
  }
  draw_plots <- function(tr, map, sc, th_row, n, png_path) {      # one PNG per dosage model
    for (md in colnames(sc)) draw_pair(png_path(tr, md), map, sc[[md]], unname(th_row[md]), tr, md, n)
  }
  group_peaks <- function(dt) {          # dt: significant markers of one trait x model, with Chrom, Position, Score
    if (nrow(dt) == 0) return(dt[, Peak := integer(0)])
    dt <- dt[order(Chrom, Position)]; dt[, Peak := NA_integer_]; pk <- 0L
    for (ch in unique(dt$Chrom)) {
      idx <- which(dt$Chrom == ch); last <- -Inf
      for (i in idx) { if (dt$Position[i] - last > PEAK_WINDOW) pk <- pk + 1L; dt$Peak[i] <- pk; last <- dt$Position[i] }
    }
    dt
  }

  # ============================================================
  # 2. RUN GWASPOLY: every covariate set x every trait
  # ============================================================
  all_lambda <- list(); all_sig <- list(); all_peaks <- list(); all_top <- list(); all_thr <- list()
  settings <- list(MODELS = MODELS, MIN_MAF = MIN_MAF, MAX_GENO_FREQ = MAX_GENO_FREQ, THRESH_LEVEL = THRESH_LEVEL)
  pheno_sig <- function(x) { f <- tempfile(); writeLines(paste(ph$Genotype, format(x, digits = 10)), f); on.exit(unlink(f)); unname(tools::md5sum(f)) }
  for (cs in names(COVARIATE_SETS)) {
    npc <- COVARIATE_SETS[[cs]]
    cat("\n================ ", cs, " (PCs as covariates: ", npc, ") ================\n", sep = "")
    d_cs <- file.path(out_dir, cs)
    for (sub in c("Manhattan_with_QQ", "Tables")) dir.create(file.path(d_cs, sub), recursive = TRUE, showWarnings = FALSE)
    rds_path <- function(tr) file.path(d_cs, "Tables", paste0("scores_", tr, "_", cs, ".rds"))
    png_path <- function(tr, md) file.path(d_cs, "Manhattan_with_QQ", paste0(tr, "__", md, ".png"))

    ph_cs <- ph[, c("Genotype", TRAITS), with = FALSE]
    if (npc > 0) ph_cs <- merge(ph_cs, pcs[, c("Genotype", paste0("PC", seq_len(npc))), with = FALSE], by = "Genotype", sort = FALSE)
    ph_file <- file.path(dir_in, paste0("pheno_GWASpoly_input_", cs, ".csv"))
    fwrite(ph_cs, ph_file, na = "NA")
    sigs <- sapply(TRAITS, function(tr) pheno_sig(ph_cs[[tr]]))

    is_done <- function(tr) {
      if (FORCE_RERUN || !file.exists(rds_path(tr))) return(FALSE)
      old <- tryCatch(readRDS(rds_path(tr)), error = function(e) NULL)
      if (is.null(old) || !identical(old$sig, sigs[[tr]]) || !identical(old$settings, settings)) return(FALSE)
      all(file.exists(vapply(colnames(old$scores), function(md) png_path(tr, md), character(1))))
    }
    todo <- TRAITS[!vapply(TRAITS, is_done, logical(1))]
    cat("Already done (skipped):", if (length(setdiff(TRAITS, todo))) paste(setdiff(TRAITS, todo), collapse = ", ") else "none", "\n")
    cat("To run now:", if (length(todo)) paste(todo, collapse = ", ") else "none", "\n")
    if (REDRAW) for (tr in setdiff(TRAITS, todo)) if (file.exists(rds_path(tr))) {      # new plot style: redraw from saved results only
      ob <- readRDS(rds_path(tr)); draw_plots(tr, ob$map, ob$scores, ob$thr, sum(is.finite(ph_cs[[tr]])), png_path); cat("  redrawn plots for", tr, "\n")
    }

    if (length(todo)) {
      dat <- read.GWASpoly(ploidy = 4, pheno.file = ph_file, geno.file = geno_out, format = "numeric",
                           n.traits = length(TRAITS), delim = ",")
      dat <- set.K(dat, LOCO = TRUE)
      prm <- if (npc > 0) set.params(MAF = MIN_MAF, geno.freq = MAX_GENO_FREQ,
                                     fixed = paste0("PC", seq_len(npc)), fixed.type = rep("numeric", npc))
             else set.params(MAF = MIN_MAF, geno.freq = MAX_GENO_FREQ)
      fit <- GWASpoly(data = dat, models = MODELS, traits = todo, params = prm, n.core = N_CORES)
      thr <- set.threshold(fit, method = "M.eff", level = THRESH_LEVEL)
      map <- as.data.frame(fit@map); setnames(map, 1:3, c("Marker", "Chrom", "Position"))
      th  <- thr@threshold
      for (tr in todo) {
        sc <- as.data.frame(fit@scores[[tr]]); stopifnot(nrow(sc) == nrow(map))
        mods <- colnames(sc)
        cat(sprintf("  %-22s n = %d genotypes | markers tested = %d\n", tr, sum(is.finite(ph_cs[[tr]])), nrow(sc)))
        draw_plots(tr, map, sc, th[tr, ], sum(is.finite(ph_cs[[tr]])), png_path)
        saveRDS(list(map = map, scores = sc, thr = th[tr, ], sig = sigs[[tr]], settings = settings), rds_path(tr))
      }
    }

    # ---- summary pass over ALL traits (new and previously done) ----
    for (tr in TRAITS) {
      obj <- readRDS(rds_path(tr)); map <- obj$map; sc <- obj$scores; th_tr <- obj$thr
      nobs <- sum(is.finite(ph_cs[[tr]]))
      for (md in colnames(sc)) {
        s <- sc[[md]]; thv <- unname(th_tr[md])
        all_lambda[[length(all_lambda) + 1]] <- data.table(CovSet = cs, Trait = tr, Model = md, n = nobs,
          Lambda = lambda_gc(s), Threshold = thv, nSignificant = sum(s > thv, na.rm = TRUE), MaxScore = max(s, na.rm = TRUE))
        dt <- data.table(CovSet = cs, Trait = tr, Model = md, map[, c("Marker", "Chrom", "Position")], Score = s, Threshold = thv)
        dt <- dt[is.finite(Score)]
        all_top[[length(all_top) + 1]] <- dt[order(-Score)][seq_len(min(TOP_N, .N))]
        sg <- dt[Score > Threshold]
        if (nrow(sg) > 0) {
          sg <- group_peaks(sg); sg[, nSigInPeak := .N, by = Peak]
          all_sig[[length(all_sig) + 1]] <- sg
          all_peaks[[length(all_peaks) + 1]] <- sg[, .SD[which.max(Score)], by = Peak][
            , .(CovSet, Trait, Model, Peak, PeakMarker = Marker, Chrom, Position, Score, Threshold, nSigInPeak)]
        }
      }
    }
  }

  # ============================================================
  # 3. SUMMARY TABLES
  # ============================================================
  cat("\n================ SUMMARY ================\n")
  dir_sum <- file.path(out_dir, "09_Summary_Tables"); dir.create(dir_sum, showWarnings = FALSE)
  lam <- rbindlist(all_lambda); fwrite(lam, file.path(dir_sum, "Genomic_inflation_and_threshold_by_trait_model.csv"))
  fwrite(rbindlist(all_top), file.path(dir_sum, "Top_markers_per_trait_model.csv"))
  sig <- if (length(all_sig)) rbindlist(all_sig, fill = TRUE) else data.table()
  pks <- if (length(all_peaks)) rbindlist(all_peaks, fill = TRUE) else data.table()
  fwrite(sig, file.path(dir_sum, "Significant_markers_all.csv")); fwrite(pks, file.path(dir_sum, "Peak_markers_all.csv"))

  cat("Genomic inflation (lambda) and number of significant markers (median lambda by covariate set):\n")
  print(lam[, .(MedianLambda = round(median(Lambda), 2), MinLambda = round(min(Lambda), 2), MaxLambda = round(max(Lambda), 2),
                ModelsWithSignificantMarkers = sum(nSignificant > 0)), by = CovSet])
  cat("\nTraits x models with significant markers:\n")
  if (nrow(lam[nSignificant > 0])) print(lam[nSignificant > 0][order(CovSet, Trait, Model), .(CovSet, Trait, Model, nSignificant, MaxScore = round(MaxScore, 2), Threshold = round(Threshold, 2), Lambda = round(Lambda, 2))], nrows = 500) else cat("None crossed the M.eff threshold.\n")
  if (nrow(pks)) { cat("\nPeaks (one row per peak, window =", PEAK_WINDOW, "bp):\n"); print(pks[order(CovSet, Trait, Model, Chrom, Position)], nrows = 500) }
  cat("\nHow to read: lambda near 1 means little inflation; well above ~1.1 means the covariate set is not controlling structure.\n",
      "Kinship-only (LOCO) model; no PC covariates.\n", sep = "")
  writeLines(c("08_GWAS folder map",
    "00_Input    GWASpoly input files",
    "K_only              kinship-only runs: Manhattan_with_QQ/ (one 600-dpi PNG per trait x model, Manhattan left and its QQ plot right; file names <trait>__<model>.png), Tables/ (R objects)",
    "09_Summary_Tables   inflation + thresholds, top markers, all significant markers, peak markers",
    "gwas_log.txt        everything printed during the run"), file.path(out_dir, "README_folder_map.txt"))
  png_files <- list.files(out_dir, pattern = "\\.png$", recursive = TRUE, full.names = TRUE)
  cat("\nPNG files written:", length(png_files), "(Manhattan + QQ pairs)\n")
  cat("Example folder:", file.path(out_dir, names(COVARIATE_SETS)[1], "Manhattan_with_QQ"), "\n")
  if (length(png_files) > 0) print(head(data.frame(file = sub(paste0(out_dir, "/"), "", png_files, fixed = TRUE), MB = round(file.size(png_files) / 1e6, 1)), 8))
  cat("\nDone. Files are in:", out_dir, "\n")
  cat("Send back gwas_log.txt (or the console output) so I can check the results.\n")
  sink()   # if the script stops early, run sink() once in the console to close the log file

}

