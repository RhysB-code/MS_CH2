             diag  = list(continuous = GGally::wrap("densityDiag", colour = "#0072B2", fill = "#56B4E9", alpha = 0.5))))
      ok <- tryCatch({ suppressWarnings(ggplot2::ggsave(f1, p, width = 9, height = 9, dpi = 600, type = "cairo")); TRUE }, error = function(e) FALSE)
      if (!ok) suppressWarnings(ggplot2::ggsave(f1, p, width = 9, height = 9, dpi = 600))
    } else {
      cat("GGally/ggplot2 not installed (install.packages(c('GGally','ggplot2'))): drew a base-R version instead.\n")
      png_cairo(f1, 9, 9)
      pairs(df, upper.panel = function(x, y, ...) { ok <- is.finite(x) & is.finite(y); r <- cor(x[ok], y[ok])
