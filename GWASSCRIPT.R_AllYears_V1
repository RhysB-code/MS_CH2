                Contains_lead = Start <= L$LeadPos & End >= L$LeadPos,
                nSigMarkersInGene = sapply(seq_len(.N), function(k) sum(sm$Position >= Start[k] & sm$Position <= End[k])),
                Runs_supporting = paste(unique(runs$Trait), collapse = ", "))]
      cand[[i]] <- ge
