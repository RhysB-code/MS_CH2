# ############################################################
# STAGE 5: ROBUSTNESS CHECKS FOR THE LEAD LOCUS (Ra01:725,408)
#   PF adjustment, class members + relatedness, leave-one-out, Mann-Whitney, permutation thresholds.
#   Runs on the check-adjusted BLUEs written by stage 1. Output: Final_Output/10_Robustness/
#   PF calls are built into the script (PF1 below). Everything is inside local() so it
#   cannot overwrite variables used by the other stages.
# ############################################################
if (RUN_ROBUST) local({
  perm_csv <- file.path(root_dir, "10_Robustness", "Permutation_thresholds.csv")
  perm_ok  <- file.exists(perm_csv) && file.size(perm_csv) > 20          # an empty file (interrupted run) does not count
